{
  "name": "ytcreator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && stylelint \"**/*.css\"",
    "typecheck": "tsc -b",
    "test": "vitest run --project '!installer'",
    "test:e2e": "pnpm --filter @ytcreator/catalog test:e2e && pnpm --filter @ytcreator/web test:e2e",
    "test:installer": "vitest run --project installer",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@ytcreator/tokens": "workspace:*",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
