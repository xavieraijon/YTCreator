#!/bin/sh
# Fake macOS `security`: items are files in $FAKE_STATE; every argv goes to argv.log, every stdin line to stdin.log.
echo "$*" >> "$FAKE_STATE/argv.log"
if [ -f "$FAKE_STATE/broken" ]; then echo "sk-ant-oat-FAKE-stdout-leak"; exit 1; fi
if [ "$1" = "-i" ]; then
  IFS= read -r line
  echo "$line" >> "$FAKE_STATE/stdin.log"
  eval "set -- $line"
fi
cmd=$1
shift
while [ $# -gt 0 ]; do
  case $1 in
    -a) account=$2; shift 2 ;;
    -s) shift 2 ;;
    -w) if [ $# -gt 1 ]; then value=$2; shift 2; else shift; fi ;;
    *) shift ;;
  esac
done
item="$FAKE_STATE/item-$account"
case $cmd in
  add-generic-password) printf '%s' "$value" > "$item" ;;
  find-generic-password) [ -f "$item" ] || exit 44; cat "$item"; echo ;;
  delete-generic-password) [ -f "$item" ] || exit 44; rm "$item" ;;
  *) exit 1 ;;
esac
