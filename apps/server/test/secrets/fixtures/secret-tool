#!/bin/sh
# Fake `secret-tool`: items are files in $FAKE_STATE; every argv goes to argv.log, stdin of `store` to stdin.log.
echo "$*" >> "$FAKE_STATE/argv.log"
if [ -f "$FAKE_STATE/broken" ]; then echo "sk-ant-oat-FAKE-stdout-leak"; exit 1; fi
[ -f "$FAKE_STATE/slow" ] && sleep 2
cmd=$1
shift
[ "$cmd" = store ] && shift
item="$FAKE_STATE/item-$4"
case $cmd in
  store) cat > "$item"; cat "$item" >> "$FAKE_STATE/stdin.log" ;;
  lookup) [ -f "$item" ] || exit 1; cat "$item" ;;
  clear) rm -f "$item" ;;
  *) exit 1 ;;
esac
