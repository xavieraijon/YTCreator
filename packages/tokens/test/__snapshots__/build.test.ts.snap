      --s-duration-normal: var(--p-duration-0);
      --s-duration-slow: var(--p-duration-0);
      --s-duration-ai-cycle: var(--p-duration-0);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    :root {
      --s-glass-bg: light-dark(var(--p-color-neutral-0), var(--p-color-neutral-850));
      --s-glass-blur: var(--p-glass-blur-off);
    }
  }

  @supports not (backdrop-filter: blur(1px)) {
    :root {
      --s-glass-bg: light-dark(var(--p-color-neutral-0), var(--p-color-neutral-850));
      --s-glass-blur: var(--p-glass-blur-off);
    }
  }
}
"
`;
