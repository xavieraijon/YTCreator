# Copia este archivo como .env y rellena los valores. NUNCA subas .env a Git.

# --- Cloudflare Workers AI (imágenes) ---
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- Azure AI Speech (voz) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# --- ai33.pro (de pago, por créditos: voz ElevenLabs/Minimax e imágenes) ---
# Clave en ai33.pro → API Key. Las herramientas solo lo usan si se elige expresamente.
AI33_API_KEY=

# --- Google Gemini (voz gratuita "Puck") ---
# Clave gratuita en aistudio.google.com/apikey (proyecto SIN facturación = nivel gratuito).
GEMINI_API_KEY=
# Opcional: clave de un proyecto con PREPAGO en AI Studio, solo si algún día se automatizan las
# imágenes de Google por API (hoy se hacen a mano con la suscripción AI Pro).
GEMINI_API_KEY_PRO=
